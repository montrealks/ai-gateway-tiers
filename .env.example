# Cloudflare AI Gateway — the only credentials any app needs.
# Provider keys are NOT here; they live in the gateway's secret store, so
# calls go keyless and no vendor key ever reaches application code.
CF_ACCOUNT_ID=
CF_AIG_TOKEN=

# Azure AI Foundry resource name (the {resource} in the deployment URL).
# Required by every Azure step in a chain.
AZURE_RESOURCE=

# Only needed when storing a new provider key. Read it from:
#   GET /accounts/$CF_ACCOUNT_ID/secrets_store/stores
CF_SECRETS_STORE_ID=
