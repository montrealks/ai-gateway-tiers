# Copy to .env and fill in. Never commit .env.

# --- Runtime (what your application needs) ---

# Cloudflare account id. Appears in the gateway base URL.
CF_ACCOUNT_ID=YOUR_ACCOUNT_ID

# AI Gateway authorization token — the app-facing bearer sent as
# `cf-aig-authorization: Bearer $CF_AIG_TOKEN`. This is NOT a provider API key.
CF_AIG_TOKEN=YOUR_AI_GATEWAY_TOKEN

# Base URL of the gateway you are calling. Change `tiers` if you named yours differently.
CF_AIG_BASE_URL=https://gateway.ai.cloudflare.com/v1/YOUR_ACCOUNT_ID/tiers

# --- Management (provisioning only — not needed at call time) ---

# Cloudflare API token with AI Gateway EDIT scope. Used to create/list/delete
# gateways and routes. Keep it out of application runtime environments.
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# --- Optional: only for scripts/test-routing.sh, which probes the direct Azure path ---

# Azure AI resource name, e.g. my-resource (the `<resource>` in the direct provider path).
AZURE_AI_RESOURCE=YOUR_AZURE_RESOURCE_NAME

# Azure model deployment name to probe.
AZURE_AI_DEPLOYMENT=YOUR_AZURE_DEPLOYMENT_NAME

# Azure API key (BYOK, sent as the `api-key` header on the direct provider path only).
AZURE_AI_KEY=YOUR_AZURE_API_KEY
